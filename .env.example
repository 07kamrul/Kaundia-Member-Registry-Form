# Google Service Account credentials
# Option 1: Path to the JSON file
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json

# Option 2: Inline JSON (for deployment)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Google Sheet ID (from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEET_ID=your-sheet-id-here

# Google Drive Folder ID (from URL: https://drive.google.com/drive/folders/{FOLDER_ID})
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
