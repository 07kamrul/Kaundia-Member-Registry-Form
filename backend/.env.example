# Uploads

# Local file storage (uploads)
# The same resolved absolute directory is used to save uploads and to serve
# them from /uploads (both are logged: "[uploads] serving directory" at
# startup, "[uploads] saved: ..." per file, "[uploads] 404 miss" per miss).
# Relative paths resolve against the working directory uvicorn starts in, so
# in Docker keep this pointing inside the persistent volume
# (docker-compose.yml sets STORAGE_BASE_DIR=/app/uploads + backend_uploads).
STORAGE_BASE_DIR=storage/kaundia/uploads

