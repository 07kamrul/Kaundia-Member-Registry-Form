# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kaundia
# For local dev without postgres, you can use:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Uploads
UPLOAD_DIR=uploads

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=Kaundia Member Registry <no-reply@example.com>

# Admin bootstrap (used by app/seed.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator

# CORS
CORS_ORIGINS=http://localhost:9091
